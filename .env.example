# Copy to `.env` for local runs or independent deployment of auth-api-nest.
# Prefer a shared PostgreSQL infra endpoint with an auth-specific database/role.
# In local/dev, `DATABASE_URL` should normally target workspace root/shared PostgreSQL; repo-local PostgreSQL is only a fallback for repo-local smoke runs.
# In deployed environments, point it at the service's shared runtime PostgreSQL endpoint and auth-owned database.
NODE_ENV=development
PORT=3032
ISSUER_URL=https://auth.lafamila.xyz
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teddy_auth
RUN_MIGRATIONS=false
CORS_ORIGINS=http://localhost:3032,http://localhost:3030,http://localhost:3031,http://localhost:3020
COOKIE_SECRET=change-me-cookie-secret

# Token lifetimes (seconds). These are the workspace defaults; an OIDC client
# may override either value per-client via its approved onboarding spec.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Refresh-token rotation grace window (seconds). Within this window a repeated
# presentation of an already-rotated refresh token is treated as a retry and is
# allowed one more rotation instead of revoking the token family. Default 60.
REFRESH_ROTATION_GRACE_SECONDS=60

# Permission webhook rollout. Apply AddPermissionWebhooks20260922000000 before
# enabling this flag. The API process owns the durable outbox worker.
PERMISSION_WEBHOOKS_ENABLED=false
PERMISSION_WEBHOOK_REQUEST_TIMEOUT_MS=5000
PERMISSION_WEBHOOK_POLL_INTERVAL_MS=1000
PERMISSION_WEBHOOK_MAX_ATTEMPTS=6
# Exact origins only (no wildcard/path). Required for HTTP or private/loopback
# destinations, e.g. Docker auth -> host-native game API:
# PERMISSION_WEBHOOK_TRUSTED_INTERNAL_ORIGINS=http://host.docker.internal:3035
PERMISSION_WEBHOOK_TRUSTED_INTERNAL_ORIGINS=
# Environment-backed subscriptions derive their key from serviceKey, for example:
# PERMISSION_WEBHOOK_SECRET_GAME_PLATFORM=change-me-at-least-32-characters

# Notification platform. Apply AddNotificationPlatform20261013000000 before
# enabling this worker. APIs persist work while disabled, but FCM delivery runs
# only when NOTIFICATIONS_ENABLED=true.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_INTERVAL_MS=1000
NOTIFICATION_RETENTION_INTERVAL_MS=3600000
# Required in production and whenever notifications are enabled. Generate with
# `openssl rand -hex 32` and keep it stable across deploys.
NOTIFICATION_TOKEN_ENCRYPTION_KEY=
# Supply exactly one environment-specific Firebase service account. Keep the
# private key quoted with literal \n line separators.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ADMIN_SESSION_COOKIE_NAME=tas_admin_session
ADMIN_OTP_ENCRYPTION_KEY=change-me-32-byte-minimum-admin-otp-encryption-key

SIGNUP_EMAIL_CODE_PEPPER=change-me-signup-email-code-pepper
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=auth@lafamila.xyz
